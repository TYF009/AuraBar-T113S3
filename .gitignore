# ---- OS / 操作系统临时文件 ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*~

# ---- Office / 文档临时文件 ----
~$*
*.tmp
*.bak

# ---- LCEDA Pro / 嘉立创EDA专业版 ----
# 工程导出缓存、自动备份（.eprj2 工程本体保留 / keep the .eprj2 project itself）
*.eprj2.bak
lceda_hist/
*.lcbak
__LCEDA_TMP__/

# ---- 固件与烧录工具产生的文件 / firmware & flashing artifacts ----
*.fw
*.img.downloading
flash_download_tool/**/logs/
flash_download_tool/**/bin/
flash_download_tool/**/flash_dump/
flash_download_tool/**/efuse_dump/
# 第三方工具体积大且有版权，不入库 / third-party tool binaries are not committed
flash_download_tool/**/*.exe
flash_download_tool/**/*.dll
flash_download_tool/**/*.zip

# ---- 软件构建产物 / software build outputs (后续软件部分) ----
software/**/build/
software/**/out/
software/**/.cache/
*.o
*.ko
*.a

# ---- 日志 ----
*.log

# ---- 保留空目录占位 ----
!**/.gitkeep
